# Lock and half-downloaded files of the sync script stay private.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
# latest.json changes with every build: browsers must ask again.
<Files "latest.json">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</Files>
# The downloads keep their names from build to build: caches may keep them
# five minutes at most.
<FilesMatch "\.(apk|zip|gz)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=300"
  </IfModule>
</FilesMatch>
